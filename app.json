{
  "expo": {
    "name": "ONE",
    "slug": "one-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/APP_L_02d.png",
    "scheme": "one-app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Die Kamera wird zum Scannen von Produkt-Barcodes benötigt.",
        "NSLocationWhenInUseUsageDescription": "Ihr Standort wird verwendet, um den nächstgelegenen Markt zu finden und um Scan & Go in einer Filiale zu ermöglichen."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/APP_L_02d_adaptive.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.oneapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFD500",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Die Kamera wird zum Scannen von Produkt-Barcodes benötigt."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ihr Standort wird verwendet, um den nächstgelegenen Markt zu finden und um Scan & Go in einer Filiale zu ermöglichen."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/APP_L_02d.png",
          "color": "#FFD500",
          "defaultChannel": "inventory-alerts"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
