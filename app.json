{
  "expo": {
    "name": "ONE",
    "slug": "one-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "one-app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Die Kamera wird zum Scannen von Produkt-Barcodes benötigt.",
        "NSLocationWhenInUseUsageDescription": "Ihr Standort wird verwendet, um den nächstgelegenen Markt zu finden."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFD500",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Die Kamera wird zum Scannen von Produkt-Barcodes benötigt."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ihr Standort wird verwendet, um den nächstgelegenen Markt zu finden."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
